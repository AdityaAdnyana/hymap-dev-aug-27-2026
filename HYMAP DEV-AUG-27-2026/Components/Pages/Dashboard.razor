@page "/dashboard"
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Dashboard - HYMAP</PageTitle>

<div class="min-h-screen bg-[#aecfc4] relative font-sans overflow-hidden flex flex-col">
    <!-- Top Double Lines (Equal Size) -->
    <div class="absolute top-0 left-0 w-full flex flex-col z-[110]">
        <div class="w-full h-6 bg-[#325c6a]"></div>
        <div class="w-full h-6 bg-[#274a56]"></div>
    </div>
    <!-- Bottom Double Lines (Equal Size) -->
    <div class="absolute bottom-0 left-0 w-full flex flex-col z-[110]">
        <div class="w-full h-6 bg-[#274a56]"></div>
        <div class="w-full h-6 bg-[#325c6a]"></div>
    </div>

    <!-- Konten Utama (Logo HYMAP di Tengah) -->
    <div class="flex-grow flex items-center justify-center z-0">
        <h1 class="text-7xl font-black text-[#475593] tracking-[0.4em] drop-shadow-md">HYMAP</h1>
    </div>
</div>
